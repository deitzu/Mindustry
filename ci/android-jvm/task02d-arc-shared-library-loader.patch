+    /** Detects Android JVMs whose runtime/vendor strings do not match the legacy OS.java checks. */
+    private boolean isAndroidRuntime(){
+        if(isAndroid) return true;
+        return propNoNull("java.runtime.name").toLowerCase(Locale.ROOT).contains("android")
+            || propNoNull("java.vm.vendor").toLowerCase(Locale.ROOT).contains("android")
+            || propNoNull("java.vendor").toLowerCase(Locale.ROOT).contains("android");
+    }
+
+    /** Returns the Android JVM resource path for the project's supported ARM64 ABI. */
+    private String androidResourcePath(String libraryName){
+        String arch = propNoNull("os.arch").toLowerCase(Locale.ROOT);
+        if(!arch.equals("aarch64") && !arch.equals("arm64") && !arch.equals("arm64-v8a")){
+            throw new ArcRuntimeException("Unsupported Android JVM native architecture: " + propNoNull("os.arch"));
+        }
+        return "arm64-v8a/lib" + libraryName + ".so";
+    }
+
     protected InputStream readFile(String path){
         if(nativesJar == null){
             InputStream input = SharedLibraryLoader.class.getResourceAsStream("/" + path);
             if(input == null) throw new ArcRuntimeException("Unable to read file for extraction: " + path);
             return input;
         }
