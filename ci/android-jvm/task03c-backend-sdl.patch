+    def androidSdlRoot = System.getenv("SDL2_ANDROID_ROOT")
+
+    if(androidSdlRoot != null && !androidSdlRoot.isBlank()){
+        addAndroid(ABI_ARM64_V8A){
+            def sdlBuild = new File(androidSdlRoot, "build").absolutePath
+            headerDirs += (String[])[
+                new File(androidSdlRoot, "include/SDL2").absolutePath,
+                new File(sdlBuild, "include/SDL2").absolutePath,
+                new File(sdlBuild, "include").absolutePath,
+                new File(sdlBuild, "include-config-release/SDL2").absolutePath
+            ]
+
+            libraries += (String[])[
+                "-L${sdlBuild}",
+                "-lSDL2",
+                "-llog",
+                "-landroid",
+                "-ldl",
+                "-lGLESv3",
+                "-lGLESv1_CM"
+            ]
+
+            androidApplicationMk += ["APP_STL := c++_static"]
+        }
+    }
     addWindows(x64, x86){
