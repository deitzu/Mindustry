index 2deda3b..0000000 100644
--- a/backends/backend-sdl/build.gradle
+++ b/backends/backend-sdl/build.gradle
@@ -50,11 +50,16 @@ jnigen{
     def mainRoot = "build/jnigen/sources"
 
     all{
-        cIncludes = ["$mainRoot/glew-2.2.0/src/glew.c"]
-        headerDirs = ["$mainRoot/glew-2.2.0/include"]
     }
 
+    // GLEW is required by the existing desktop OpenGL targets only.
+    each({ it.os != Android }){
+        cIncludes = ["$mainRoot/glew-2.2.0/src/glew.c"]
+        headerDirs = ["$mainRoot/glew-2.2.0/include"]
+    }
+
     addLinux(x64, x86){
         cppFlags += execCmd("sdl2-config --cflags").split(" ")
         cFlags = cppFlags
@@ -75,6 +80,25 @@ jnigen{
         linkerFlags += (String[])["-L${sdlRoot.replace("\\", "/")}/lib"]
     }
 
+    addAndroid(AndroidABI.ABI_ARM64_V8A){
+        def sdlRoot = System.getenv("SDL2_ANDROID_ROOT")
+        if(sdlRoot == null || sdlRoot.isBlank()){
+            throw new GradleException("SDL2_ANDROID_ROOT is required for the Android SDL probe")
+        }
+
+        def sdlBuild = new File(sdlRoot, "build").absolutePath
+        headerDirs += (String[])[
+            new File(sdlRoot, "include/SDL2").absolutePath,
+            new File(sdlBuild, "include").absolutePath,
+            new File(sdlBuild, "include-config-release/SDL2").absolutePath
+        ]
+
+        libraries += (String[])[
+            "-L${sdlBuild}",
+            "-lSDL2",
+            "-llog",
+            "-landroid",
+            "-ldl",
+            "-lGLESv2",
+            "-lGLESv1_CM"
+        ]
+
+        androidApplicationMk += ["APP_STL := c++_static"]
+    }
+
     if(System.getProperty("os.arch") != "aarch64"){
         addMac(x64, ARM){
             cppFlags = cFlags = (execCmd("sdl2-config --cflags") + " -c -Wall -O2 -arch x86_64 -DFIXED_POINT -fmessage-length=0 -fPIC -mmacosx-version-min=10.9 -stdlib=libc++").split(" ")
             linkerFlags = "-shared -arch x86_64 -mmacosx-version-min=10.9 -stdlib=libc++".split(" ")
